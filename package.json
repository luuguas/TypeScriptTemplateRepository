{
  "name": "@luuguas/typescript-template-repository",
  "version": "0.2.1",
  "description": "TypeScriptを用いた開発用のテンプレートリポジトリ",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn tsdown",
    "lint": "yarn eslint",
    "lint-fix": "yarn eslint --fix",
    "test": "yarn vitest run --coverage",
    "test-watch": "yarn vitest watch"
  },
  "author": "luuguas",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
